#!/usr/bin/env bash

set -o pipefail
set -o errexit
set -o nounset
set -o errtrace
shopt -s inherit_errexit

c_help="Usage: $(basename "$0") [-h|--help]

Prints the currently-visible terminal screen content to stdout, with per-line trailing whitespace
and leading/trailing blank lines trimmed (iTerm2 pads visible lines with trailing spaces).

Backends:
  - macOS/iTerm2: reads the session buffer via AppleScript
  - Linux/Tilix:  reads the focused terminal through AT-SPI"

function decode_cmdline_args {
  local params
  params=$(getopt --options h --long help --name "$(basename "$0")" -- "$@")

  eval set -- "$params"

  while true; do
    case $1 in
      -h|--help)
        echo "$c_help"
        exit 0 ;;
      --)
        shift
        break ;;
    esac
  done

  if [[ $# -ne 0 ]]; then
    echo "$c_help"
    exit 1
  fi
}

function scrape_macos {
  if [[ "${TERM_PROGRAM:-}" != "iTerm.app" && -z "${ITERM_SESSION_ID:-}" ]]; then
    echo "$(basename "$0"): requires iTerm2 (TERM_PROGRAM=${TERM_PROGRAM:-})" >&2
    return 1
  fi

  osascript -e 'tell application "iTerm2" to tell current session of current window to get contents'
}

function scrape_linux {
  /usr/bin/python3 "$(dirname "${BASH_SOURCE[0]}")/scrape_terminal_screen_atspi.py"
}

function main {
  if [[ "$OSTYPE" == darwin* ]]; then
    scrape_macos
  else
    scrape_linux
  fi | perl -0777 -pe 's/[ \t]+$//mg; s/^\n+|\n+$//g'
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  decode_cmdline_args "$@"
  main
fi

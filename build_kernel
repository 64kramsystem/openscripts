#!/usr/bin/env bash

set -o pipefail
set -o errexit
set -o nounset
set -o errtrace
shopt -s inherit_errexit

# Resolves in both layouts: openscripts/lib/ in the checkout, helpers/lib/ once installed on arcade.
c_script_directory=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/kernel_build.sh
source "$c_script_directory/lib/kernel_build.sh"

c_logfile=$(dirname "$(mktemp --dry-run)")/$(basename "$0").log
c_bisect_local_version=bisect
c_crack_bundle_temp_file=$(mktemp --suffix=-crack.bundle)
c_help="Usage: $(basename "$0") [-h|--help] <options...> [packages_destination]

Builds a kernel from the source code.

The list (newline-separated) of built packages is sent to FD 3 (if open/valid).

Options:

- [-v|--kernel-version <version>]  : if 'M.m', the latest version is set; RCs must be set in the format 'M.m-rcN'.
- [-b|--bisect]                    : bisect mode (see below); incompatible with '--kernel-version'
- [-l|--local-version <name>]      : set the kernel local version (name suffix), defaults to \$BUILD_KERNEL_LOCAL_VERSION; the
                                     minus is automatically added
- [--cpu-target <cpu>]             : GCC -march/-mtune target, defaults to \$BUILD_KERNEL_CPU_TARGET or znver5
- [--gcc-package <package>]        : installed gcc-N package, defaults to \$BUILD_KERNEL_GCC_PACKAGE or the newest installed GCC
- [--unattended]                   : fail instead of prompting, defaults to \$BUILD_KERNEL_UNATTENDED
- [-e|--enable-unused-modules]     : enable unused modules (by default, they're disabled)
- [-f|--faster-build]              : disable LTO and sanitizers for faster builds (automatically enabled in bisect mode)
- [-c|--cherry-pick <c1,c2,...>]   : cherry pick commits, defaults to \$BUILD_KERNEL_CHERRY_PICKS; see help below for the format
- [--sav-remote <remote>]          : replay the remote's per-major sav branch onto the target version, defaults to \$BUILD_KERNEL_SAV_REMOTE; see help below
- [-i|--install]
- [-F|--force]                     : rebuild even if packages for the target version already exist
- [-r|--repo-path <path>]          : defaults to (current path or \$BUILD_KERNEL_REPO_PATH env variable)
- [-d|--display-config-diff]       : display config diff in meld after applying modifications

Parameters:

- packages_destination : mandatory; can be specified via \$BUILD_KERNEL_PACKAGES_DESTINATION

Options/parameters override the corresponding env variables.

Workflow (regular):

- works with EITHER Ubuntu kernel tree OR mainline kernel (kernel.org)
- if debian.master/ is not present, automatically downloads packaging from Ubuntu mainline PPA crack.bundle
- the crack.bundle contains Ubuntu packaging structure WITHOUT Ubuntu patches (pure mainline kernel)
- fetches the remote(s) and finds the latest patch version, for the running or specified kernel
- checks the target version's branch out
- find the target version's config, and copies it to the packages destination
- patches the configuration to make it compile, and updates it
- modifies debian.master/ files to produce Ubuntu mainline-compatible packages
- removes the old packages/configs from the packages destination
- builds and moves the packages to the packages destination (via debian/rules)
- produces packages with naming like: linux-headers-6.19-061900-mybuild-generic, linux-image-unsigned-6.19-061900-mybuild-generic
- if --install is specified, it installs the packages

Workflow (bisect):

- some features are disabled (LTO/sanitizers) for faster builds
- the kernel local version is set to '$c_bisect_local_version', overriding any user setting
- the kernel version is gathered from the latest tag reachable from HEAD
- (the configuration is handled as regular)
- removes the old packages (not the configs) from the packages destination
- builds and moves the packages to the packages destination
- installs the packages

Cherry picking:

- incompatible with bisect workflow
- format: '[shortver:]ca{,cb…}/…'
- each commit can be prefixed with 'R', which will revert the given commit

Sav branch:

- incompatible with bisect and cherry picking
- takes a remote name (e.g. 'fork'); the branch is composed from the target version as
  '<remote>/v<M.m>-sav' (e.g. building 7.1.4 -> 'fork/v7.1-sav'), so it follows the version
  automatically and holds one commit set per major version
- the commits unique to that branch (merge-base..branch) are replayed onto the target version's tag
  with 'git rebase --onto', which 3-way merges them, drops commits already present upstream, and
  aborts on a genuine conflict
- the replay lands on the '$c_cherry_pick_branch' branch, cleaned up like a cherry-pick run

Mainline-like build details:

The build system produces packages compatible with the Ubuntu mainline PPA format, working with both
Ubuntu kernel trees (which include debian.master/) and vanilla mainline kernel.org repositories.

crack.bundle mechanism:
- when debian.master/ is absent, the script automatically downloads 'crack.bundle' from the Ubuntu mainline PPA
- crack.bundle is a git bundle containing Ubuntu's packaging infrastructure (debian/ and debian.master/ directories)
- it provides the build system WITHOUT Ubuntu's patches, designed for building pure mainline kernels
- bundles are fetched from: https://kernel.ubuntu.com/mainline/vX.Y-rcN/crack.bundle or vX.Y.Z/crack.bundle

Packaging extraction:
- the bundle is fetched into the current repo using git fetch (bundles have dependencies on upstream commits)
- the script extracts the latest 'cod/mainline/*' tag from the bundle (e.g., cod/mainline/v6.19.0)
- debian/ and debian.master/ directories are checked out from this tag into the working tree

Build modifications:
- changelog is modified to include the local version suffix and current timestamp
- ABI number is generated Ubuntu-style: 6.19.0 → 061900, 6.10.0-rc1 → 061000rc1
- gcc version is auto-detected from installed packages and configured in debian/rules.d/
- annotations and config are restricted to amd64 architecture only
- builds use debian/rules targets (clean, defaultconfigs, binary-headers, build-arch, binary-debs)
- mainline PPA flags are applied: do_mainline_build=true, do_tools=0, do_lib_rust=false, do_extras_package=false

Package output:
- produces 4 packages matching the mainline PPA format:
  1. linux-headers-X.Y-NNNNNN[-localver]_X.Y-NNNNNN[-localver].TIMESTAMP_all.deb
  2. linux-headers-X.Y-NNNNNN[-localver]-generic_X.Y-NNNNNN[-localver].TIMESTAMP_amd64.deb
  3. linux-image-unsigned-X.Y-NNNNNN[-localver]-generic_X.Y-NNNNNN[-localver].TIMESTAMP_amd64.deb
  4. linux-modules-X.Y-NNNNNN[-localver]-generic_X.Y-NNNNNN[-localver].TIMESTAMP_amd64.deb
- additional packages (linux-buildinfo-*, linux-lib-rust-*) are created during build but automatically removed
- the local version (if specified) appears in package names and versions, e.g.: linux-headers-6.19-061900-mybuild-generic
"

v_kernel_version=
v_bisect=               # boolean; false=blank; true=anything else
v_install=              # boolean; false=blank; true=anything else
v_force=                # boolean; false=blank; true=anything else
v_packages_destination=${BUILD_KERNEL_PACKAGES_DESTINATION:-}
v_repo_path=${BUILD_KERNEL_REPO_PATH:-}
v_local_version=${BUILD_KERNEL_LOCAL_VERSION:-}
v_cpu_target=${BUILD_KERNEL_CPU_TARGET:-znver5}
v_gcc_package=${BUILD_KERNEL_GCC_PACKAGE:-}
v_unattended=${BUILD_KERNEL_UNATTENDED:-}
v_display_config_diff=  # boolean; false=blank; true=anything else
v_raw_cherry_picks=${BUILD_KERNEL_CHERRY_PICKS:-} # see help for the format
v_sav_remote=${BUILD_KERNEL_SAV_REMOTE:-} # remote holding the per-major sav branch to replay; see help
v_enable_unused_modules= # boolean; false=blank; true=anything else
v_faster_build=         # boolean; false=blank; true=anything else
v_cherry_pick_branch_created= # boolean; set when this run creates $c_cherry_pick_branch, so the
                              # exit hook only deletes a branch we created (not a user's own)

function decode_cmdline_args {
  local params
  params=$(getopt --options hv:biFr:l:defc: \
    --long help,kernel-version:,bisect,install,force,repo-path:,local-version:,cpu-target:,gcc-package:,unattended,display-config-diff,enable-unused-modules,faster-build,cherry-pick:,sav-remote: \
    --name "$(basename "$0")" -- "$@")

  eval set -- "$params"

  while true; do
    case $1 in
      -h|--help)
        echo "$c_help"
        exit 0 ;;
      -v|--kernel-version)
        v_kernel_version=$2
        shift 2 ;;
      -b|--bisect)
        v_bisect=1
        shift ;;
      -i|--install)
        v_install=1
        shift ;;
      -F|--force)
        v_force=1
        shift ;;
      -r|--repo-path)
        v_repo_path=$2
        shift 2 ;;
      -l|--local-version)
        v_local_version=$2
        shift 2 ;;
      --cpu-target)
        v_cpu_target=$2
        shift 2 ;;
      --gcc-package)
        v_gcc_package=$2
        shift 2 ;;
      --unattended)
        v_unattended=1
        shift ;;
      -d|--display-config-diff)
        v_display_config_diff=1
        shift ;;
      -e|--enable-unused-modules)
        v_enable_unused_modules=1
        shift ;;
      -f|--faster-build)
        v_faster_build=1
        shift ;;
      -c|--cherry-pick)
        v_raw_cherry_picks=$2
        shift 2 ;;
      --sav-remote)
        v_sav_remote=$2
        shift 2 ;;
      --)
        shift
        break ;;
    esac
  done

  if [[ $# -gt 1 ]]; then
    echo "Only one argument is allowed!"
    exit 1
  elif [[ -n $v_bisect && -n $v_kernel_version ]]; then
    echo "Bisection and specific kernel version are incompatible!"
    exit 1
  elif [[ -n $v_bisect && -n $v_raw_cherry_picks ]]; then
    echo "Bisection and cherry picking are incompatible!"
    exit 1
  elif [[ -n $v_bisect && -n $v_sav_remote ]]; then
    echo "Bisection and sav branch are incompatible!"
    exit 1
  elif [[ -n $v_raw_cherry_picks && -n $v_sav_remote ]]; then
    echo "Cherry picking and sav branch are incompatible!"
    exit 1
  elif [[ $# -eq 1 ]]; then
    v_packages_destination=$1
  else
    if [[ -z $v_packages_destination ]]; then
      >&2 echo "Missing packages destination!"
      exit 1
    fi
  fi

  if [[ ! -d $v_packages_destination ]]; then
    >&2 echo "Invalid packages destination!"
    exit 1
  fi

  validate_toolchain

  if [[ -n $v_bisect ]]; then
    v_local_version=$c_bisect_local_version
    v_install=1
    v_faster_build=1
  fi
}



function cache_sudo {
  sudo -v

  while true; do
    sleep 60
    kill -0 "$$" || exit
    sudo -nv
  done 2>/dev/null &
}

# Return format: normalized version.
#
function find_running_kernel_version {
  local raw_version
  # Supports all the formats, including the Ubuntu-mainline-PPA RC form this script itself
  # produces, where the RC marker is embedded in the ABI rather than as a `-rcN` suffix:
  #
  #   7.0.0-070000rc7-sav-generic  -> 7.0-rc7   (RC: rc in ABI)
  #   6.8.0-060800rc1-generic      -> 6.8-rc1   (RC: rc in ABI)
  #   7.0-rc7-generic              -> 7.0-rc7   (RC: -rcN suffix, kernel.org form)
  #   7.0.0-070000-sav-generic     -> 7.0.0     (GA with ABI)
  #   6.19.6-061906-sav-generic    -> 6.19.6    (stable patch)
  #
  raw_version=$(uname -r | perl -ne '
    if (/^(\d+\.\d+)(?:\.(\d+)|-rc(\d+))?(?:-(\d+)(?:rc(\d+))?)?/) {
      my ($mm, $patch, $ver_rc, $abi_rc) = ($1, $2, $3, $5);
      my $rc = defined $ver_rc ? $ver_rc : $abi_rc;
      print defined $rc ? "$mm-rc$rc" : (defined $patch ? "$mm.$patch" : $mm);
    }')

  if [[ ! $raw_version =~ ^[0-9]+\.[0-9]+ ]]; then
    >&2 echo "Error: Could not extract kernel version from '$(uname -r)'"
    exit 1
  fi

  normalize_kernel_version "$raw_version"
}



function register_exit_hook {
  function _exit_hook {
    set +o errexit

    "${SCRIPTING_ALARM_PROGRAM:-true}"

    rm -f "$c_crack_bundle_temp_file"

    # Only clean up the cherry-pick branch if THIS run created it; otherwise a user's own branch
    # that happens to share the name must be left untouched.
    if [[ -n $v_cherry_pick_branch_created ]] && git rev-parse --verify "$c_cherry_pick_branch" >/dev/null 2>&1; then
      local current_branch
      current_branch=$(git rev-parse --abbrev-ref HEAD)

      if [[ $current_branch == "$c_cherry_pick_branch" ]]; then
        git checkout -q -
      fi

      git branch -D -q "$c_cherry_pick_branch"
    fi
  }

  trap _exit_hook EXIT
}

function setup_logging {
  exec 5> "$c_logfile"
  BASH_XTRACEFD=5
  exec > >(tee -ai "$c_logfile") 2>&1
  set -x
}



# Return format: normalized version.
#
function find_branch_kernel_version {
  git describe --tags --abbrev=0 \
    | perl -pe 's/^v\d+\.\d+\K$/.0/' \
    | perl -pe 's/^v//'
}








function check_if_version_already_packaged {
  local building_kernel_version=$1

  if [[ -n $v_force ]]; then
    return
  fi

  # Format: `M.m.p` or or `M.m-rcN`.
  #
  local latest_packaged_version
  latest_packaged_version=$(find_latest_packaged_version "$building_kernel_version")

  if [[ $building_kernel_version == "$latest_packaged_version" ]]; then
    echo "No new version! Latest packaged/available: $building_kernel_version"
    exit 0
  fi
}




function print_sorted_commits_diff {
  local upstream=$1 head=$2

  # Strip the .0 patch version from the GA releases if present, since it's not present it the tags.
  #
  upstream=$(short_kernel_version "$upstream" with_rc)
  head=$(short_kernel_version "$head" with_rc)

  git cherry -v "v$upstream" "v$head" | sort -k3
}



# Helpers: stage config option changes, applied in one pass by flush_annotations.
#
# Usage:
#   annotation_set CONFIG_NAME value     # set to y/n/m/number/string
#   annotation_undefine CONFIG_NAME      # remove from annotations
#
# These modify debian.master/config/annotations, the source of truth for the Ubuntu build system.
# The build regenerates .config from annotations, so scripts/config modifications to .config or
# config.common.amd64 are discarded.
#
# Applying each change via a separate `annotations` invocation reparses and rewrites the large
# annotations file every time, which adds over a minute across all the options set below; instead
# the changes are accumulated and flushed in a single `annotations` process.
#
_annotation_ops=()

# Configs we explicitly set to n. verify_disabled_modules checks only these, so that stock-n
# annotations forced back on by the build (e.g. CONFIG_GENKSYMS) don't trigger a spurious prompt.
_disabled_configs=()






# Additional optimizations for bisect mode to reduce compile time.
# These make the kernel slower but compile much faster.
#
function make_build_faster {
  # Disable LTO - link time optimization is very slow
  annotation_set CONFIG_LTO_NONE y
  annotation_set CONFIG_LTO_CLANG_FULL n
  annotation_set CONFIG_LTO_CLANG_THIN n

  # Disable other sanitizers/debug that slow down builds
  annotation_set CONFIG_KASAN n
  annotation_set CONFIG_KCSAN n
  annotation_set CONFIG_UBSAN n
  annotation_set CONFIG_GCOV_KERNEL n
}




function display_config_diff {
  # Compare before/after annotations export.
  # The .config.before_modifications file is saved before config functions run.
  #
  if ! diff .config.before_modifications .config.after_modifications > /dev/null 2>&1; then
    meld .config.before_modifications .config.after_modifications
  fi
}

# $1: building kernel version
#
# $v_raw_cherry_picks can be empty, in which case no CPs are performed.
#
function cherry_pick_commits {
  if [[ -n $v_raw_cherry_picks ]]; then
    local short_building_kernel_version
    short_building_kernel_version=$(short_kernel_version "$1" no_rc)

    local raw_cherry_pick_entries
    mapfile -td'/' raw_cherry_pick_entries < <(echo -n "$v_raw_cherry_picks")

    for cherry_picks_entry in "${raw_cherry_pick_entries[@]}"; do
      local entry_kernel_version=${cherry_picks_entry%:*}

      # In the second expression, there is no kernel prefix.
      #
      if [[ $entry_kernel_version == "$short_building_kernel_version" || $entry_kernel_version == "$cherry_picks_entry" ]]; then
        # Switch to a temporary branch only when there are CPs for the building kernel; this
        # makes the output cleaner.
        #
        local current_branch
        current_branch=$(git rev-parse --abbrev-ref HEAD)

        if [[ $current_branch != "$c_cherry_pick_branch" ]]; then
          # Refuse to adopt (and later delete) a branch this run didn't create.
          if git rev-parse --verify "$c_cherry_pick_branch" >/dev/null 2>&1; then
            >&2 echo "Branch '$c_cherry_pick_branch' already exists; remove it manually if it's stale."
            exit 1
          fi
          git checkout -b "$c_cherry_pick_branch"
          v_cherry_pick_branch_created=1
        fi

        local entry_raw_commits=${cherry_picks_entry#*:}

        local entry_commits
        mapfile -td, entry_commits < <(echo -n "$entry_raw_commits")

        for commit in "${entry_commits[@]}"; do
          if [[ $commit == R* ]]; then
            commit=${commit#R}
            echo "# REVERT $commit #######################################################"
            git revert --no-edit "$commit"
          else
            echo "# CHERRY PICK $commit ##################################################"
            git cherry-pick "$commit"
          fi
        done
      elif [[ ! $entry_kernel_version =~ ^[[:digit:]]+\.[[:digit:]]+ ]]; then
        >&2 echo "Wrong cherry pick format: $cherry_picks_entry"
        exit 1
      fi
    done
  fi
}













# Doesn't uninstall the libc package (which doesn't carry the local version), but we can live with it.
#
function remove_installed_bisect_kernels {
  sudo aptitude purge -y ~i"linux-.*-$c_bisect_local_version"
}

# $1: see find_built_packages().
#
function install_kernel_packages {
  local packages_to_install
  mapfile -t packages_to_install < <(echo -n "$1")

  sudo dpkg -i "${packages_to_install[@]}"
}


function main {
  if [[ $EUID -eq 0 ]]; then
    >&2 echo "This script must not be run with sudo permissions."
    exit 1
  fi

  if [[ -n $v_install ]]; then
    cache_sudo
  fi

  if [[ -n $v_repo_path ]]; then
    cd "$v_repo_path"
  fi

  register_exit_hook

  setup_logging

  # The tag (and mainline PPA path) for `M.m.0` versions is in the `M.m` format.
  # We need to normalize regardless, because the version can also be passed by the user.

  local running_kernel_version
  running_kernel_version=$(find_running_kernel_version)

  if [[ -z $v_bisect ]]; then
    fetch_remotes
  fi

  local building_kernel_version

  if [[ -z $v_bisect ]]; then
    # Using this structure for clarity.
    #
    if [[ -z $v_kernel_version ]]; then
      building_kernel_version=$(find_latest_kernel_version "$running_kernel_version")
    elif [[ $v_kernel_version =~ ^[[:digit:]]+\.[[:digit:]]+$ ]]; then
      building_kernel_version=$(find_latest_kernel_version "$v_kernel_version")
    else
      building_kernel_version=$v_kernel_version
    fi

    check_if_version_already_packaged "$building_kernel_version"

    create_if_required_and_switch_branch "$building_kernel_version"

    # When specifying a different kernel version, don't display the diff.
    #
    if [[ -z $v_kernel_version ]] && same_major_minor_version "$running_kernel_version" "$building_kernel_version"; then
      print_sorted_commits_diff "$running_kernel_version" "$building_kernel_version"
    fi

    cherry_pick_commits "$building_kernel_version"
    apply_sav_branch "$building_kernel_version"
  else
    building_kernel_version=$(find_branch_kernel_version)
  fi

  verify_or_setup_ubuntu_packaging "$building_kernel_version"

  # Configs are stored in short form (config-7.0 for GA, config-7.0-rc7 for RC, config-6.19.6 for
  # patch releases), so the lookup must use the short version, not the full M.m.0 form.
  #
  local source_config_file
  source_config_file=$(find_local_config_file_for_version "$(short_kernel_version "$building_kernel_version" with_rc)")

  # If the matching version is not found locally, search it on the mainline PPA.
  #
  if [[ -z $source_config_file ]]; then
    source_config_file=$(find_most_recent_config_version_available "$building_kernel_version")
  fi

  import_config_file "$source_config_file"

  setup_ubuntu_packaging
  verify_single_directory_run_parts

  # Move the base config to Ubuntu location (will be used as template)
  finalize_ubuntu_config

  # Prepare Ubuntu build environment (regenerates configs from annotations + base config)
  prepare_ubuntu_build

  # Save pre-modification config export for display_config_diff
  if [[ -n $v_display_config_diff ]]; then
    python3 debian/scripts/misc/annotations --arch amd64 --export > .config.before_modifications
  fi

  # Apply config modifications to annotations (the source of truth for the build).
  #
  # The build system regenerates .config from annotations via `annotations --export`,
  # so modifying .config or config.common.amd64 directly has no effect.
  #
  fix_ubuntu_config
  disable_debug_info
  configure_cpu_target

  if [[ -n $v_faster_build ]]; then
    make_build_faster
  fi

  if [[ -z $v_enable_unused_modules ]]; then
    disable_unused_modules "$building_kernel_version"
  fi

  flush_annotations

  # Skip in bisect mode: an override is consistent across runs, so the prompt would only block
  # unattended bisects.
  if [[ -z $v_enable_unused_modules && -z $v_bisect ]]; then
    verify_disabled_modules
  fi

  if [[ -n $v_display_config_diff ]]; then
    python3 debian/scripts/misc/annotations --arch amd64 --export > .config.after_modifications
    display_config_diff
  fi

  time compile_kernel

  # Config files are handled based on $v_bisect.
  #
  remove_destination_old_version_files "$building_kernel_version" "$source_config_file"

  move_packages_and_cleanup "$building_kernel_version"

  local built_packages
  built_packages=$(find_built_packages "$building_kernel_version")

  if [[ -n $v_install ]]; then
    if [[ -n $v_bisect ]]; then
      remove_installed_bisect_kernels
    fi
    install_kernel_packages "$built_packages"
  fi

  send_built_packages_to_fd3 "$built_packages"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  decode_cmdline_args "$@"
  main
fi

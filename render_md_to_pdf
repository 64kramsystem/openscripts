% https://github.com/fabiensanglard/gebbwolf3/blob/master/src/cover.tex
% Commodware retains the Pepto C64 palette; Palware deliberately paints no background.
\definecolor{coverforeground}{HTML}{COVER_FOREGROUND}
\definecolor{coveraccent}{HTML}{COVER_ACCENT}
\definecolor{weblink}{HTML}{LINK_COLOR}
\hypersetup{urlcolor=weblink,filecolor=weblink,
  urlbordercolor=weblink,filebordercolor=weblink}
\newcommand{\bookcover}[1]{%
  \hypersetup{pdftitle={BOOK_LABEL: #1},pageanchor=false}%
  \begin{titlepage}
    COVER_BACKGROUND
    \color{coverforeground}\thispagestyle{empty}%
    \centering\bfseries
    \vspace*{95bp}%
    {\resizebox{!}{HEADING_HEIGHT bp}{COVER_HEADING}\par}%
    \vspace{20bp}%
    {\color{coveraccent}\resizebox{\linewidth}{110bp}{COVER_BANNER}\par}%
    \vspace{225bp}%
    {\fontsize{TITLE_SIZE bp}{TITLE_LEADING bp}\selectfont\MakeUppercase{#1}\par}%
    \vfill
  \end{titlepage}
  \nopagecolor
  \hypersetup{pageanchor=true}%
}

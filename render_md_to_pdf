\setcounter{tocdepth}{3}
% Match Keen's 1.2 leading and blank-line paragraph separation at our reading size.
\renewcommand{\normalsize}{\fontsize{18bp}{21.6bp}\selectfont}
\renewcommand{\large}{\fontsize{21.6bp}{25.92bp}\selectfont}
\renewcommand{\Large}{\fontsize{25.92bp}{31.104bp}\selectfont}
% Book title, main sections, and topics use Keen's chapter/section/subsection size ratios.
\makeatletter
\renewcommand{\section}{\@startsection{section}{1}{\z@}
  {-3.5ex \@plus -1ex \@minus -.2ex}{2.3ex \@plus .2ex}
  {\normalfont\raggedright\hyphenpenalty=10000\fontsize{44.784bp}{53.7408bp}\selectfont\bfseries}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}
  {-3.25ex \@plus -1ex \@minus -.2ex}{1.5ex \@plus .2ex}
  {\normalfont\raggedright\hyphenpenalty=10000\Large\bfseries}}
\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{\z@}
  {-3.25ex \@plus -1ex \@minus -.2ex}{1.5ex \@plus .2ex}
  {\normalfont\raggedright\hyphenpenalty=10000\large\bfseries}}
% Keep TOC entries and bookmarks free of the heading's return link.
\newcommand{\topicheading}[1]{%
  \subsubsection[#1]{\hyperlink{toc-\@currentHref}{#1}}}
% Include all three heading levels; only the document title is starred above.
% Distinguish chapters, sections and leaves by both size and weight.
\renewcommand{\l@section}[2]{%
  \addpenalty{\@secpenalty}\addvspace{14.4bp}%
  \begingroup\normalfont\fontsize{22bp}{26.4bp}\selectfont\bfseries
    \@dottedtocline{1}{0bp}{0bp}{#1}{#2}%
  \endgroup\nopagebreak}
\renewcommand{\l@subsection}[2]{%
  \addpenalty{\@secpenalty}\addvspace{7.2bp}%
  \begingroup\normalfont\fontsize{18bp}{21.6bp}\selectfont\bfseries
    \@dottedtocline{2}{18bp}{0bp}{#1}{#2}%
  \endgroup\nopagebreak}
\renewcommand{\l@subsubsection}[2]{%
  \begingroup\normalfont\fontsize{16bp}{19.2bp}\selectfont
    \@dottedtocline{3}{36bp}{0bp}
      {\Hy@raisedlink{\hypertarget{toc-\Hy@tocdestname}{}}#1}{#2}%
  \endgroup}
\renewcommand{\tableofcontents}{%
  \subsection*{\contentsname}%
  \begingroup
    \setlength{\parskip}{0bp}%
    \@starttoc{toc}%
  \endgroup
  \clearpage}
\makeatother

#!/usr/bin/env bash

set -o pipefail
set -o errexit
set -o nounset
set -o errtrace
shopt -s inherit_errexit

c_default_columns=129
c_help="Usage: $(basename "$0") [-h|--help] [-o|--output PDF] [--font-size BP] [--line-spacing BP] [--margin BP] INPUT.asm

Generates a highlighted x86 assembly listing PDF with clickable references. Lines wrap at words to the calculated chars/line limit; comment continuations retain their prefix, and over-limit words are errors.
Symbol links recognize Ghidra rows containing an address, contiguous bytes, mnemonic, and operands; label definitions begin in column 1.

Defaults: --font-size 14.1070416 --line-spacing 19.5 --margin 25.984251968504 (horizontal)
Chars/line = floor((1024 - 2 * margin) / (0.5248718262 * font-size)) - 2; defaults: ${c_default_columns}.
Requires: Ruby, pdflatex, and TeX Live packages ec, geometry, hyperref, listings, and xcolor."

# Defaults preserve White_Papers_Keen_code_sample.pdf typography on an iPad Air 13-inch portrait canvas.
v_font_size=14.1070416
v_line_spacing=19.5
v_margin=25.984251968504
v_input=
v_output=
v_temp_dir=
v_columns=

function decode_cmdline_args {
  local params
  params=$(getopt --options ho: --long help,output:,font-size:,line-spacing:,margin: --name "$(basename "$0")" -- "$@")
  eval set -- "$params"

  while true; do
    case $1 in
      -h|--help)
        echo "$c_help"
        exit 0 ;;
      -o|--output)
        v_output=$2
        shift 2 ;;
      --font-size)
        v_font_size=$2
        shift 2 ;;
      --line-spacing)
        v_line_spacing=$2
        shift 2 ;;
      --margin)
        v_margin=$2
        shift 2 ;;
      --)
        shift
        break ;;
    esac
  done

  if [[ $# -ne 1 ]]; then
    echo "$c_help"
    exit 1
  fi

  v_input=$1
  if [[ -z $v_output ]]; then
    if [[ ${v_input##*/} == *.* ]]; then
      v_output=${v_input%.*}.pdf
    else
      v_output=$v_input.pdf
    fi
  fi
  [[ $v_output == /* ]] || v_output="$PWD/$v_output"
}

function validate_parameters {
  if [[ ! -f $v_input || ! -r $v_input ]]; then
    >&2 echo "Unreadable input file: $v_input"
    exit 1
  fi

  local value
  for value in "$v_font_size" "$v_line_spacing" "$v_margin"; do
    if [[ ! $value =~ ^([0-9]+([.][0-9]+)?|[.][0-9]+)$ ]] || [[ ! $value =~ [1-9] ]]; then
      >&2 echo "Invalid positive number: $value"
      exit 1
    fi
  done

  local command
  for command in ruby pdflatex; do
    if ! command -v "$command" >/dev/null; then
      >&2 echo "$command is required"
      exit 1
    fi
  done

  # Reserve two columns because exact-fit listings and PDF links overflowed in rendered fixtures.
  v_columns=$(ruby -e 'puts(((1024 - 2 * ARGV[1].to_f) / (0.5248718262 * ARGV[0].to_f)).floor - 2)' "$v_font_size" "$v_margin")
  if (( v_columns < 1 )); then
    >&2 echo "Font size and margin leave no usable columns"
    exit 1
  fi
}

function prepare_files {
  v_temp_dir=$(mktemp -d /tmp/asm-listing-pdf.XXXXXX)
  trap 'rm -rf "$v_temp_dir"' EXIT

  ruby - "$v_input" "$v_temp_dir/listing.asm" "$v_columns" <<'RUBY'
input, output, columns = ARGV
columns = Integer(columns)
source = File.binread(input)
abort "Input contains reserved PDF-link delimiter" if source.include?("(*@") || source.include?("@*)")

COMMENT_COLUMN = 16

def comment_index(line)
  quote = nil
  escaped = false
  line.each_byte.with_index do |byte, index|
    if escaped
      escaped = false
    elsif quote && byte == 92
      escaped = true
    elsif quote
      quote = nil if byte == quote
    elsif byte == 34 || byte == 39
      quote = byte
    elsif byte == 59
      return index
    end
  end
  nil
end

def wrap_at_words(text, first_prefix, continuation_prefix, columns, line_number)
  if text.empty?
    abort "Line #{line_number} cannot be wrapped within #{columns} columns" if first_prefix.bytesize > columns
    return [first_prefix]
  end

  lines = []
  prefix = first_prefix
  until text.empty?
    capacity = columns - prefix.bytesize
    abort "Line #{line_number} has no room for wrapped text within #{columns} columns" if capacity < 1
    if text.bytesize <= capacity
      lines << prefix + text
      break
    end

    break_at = text.byteslice(0, capacity + 1).rindex(/[ \t]/)
    unless break_at&.positive?
      if prefix != continuation_prefix
        lines << prefix.rstrip
        prefix = continuation_prefix
        next
      end
      abort "Line #{line_number} contains a word longer than the #{columns}-column limit"
    end

    lines << prefix + text.byteslice(0, break_at).rstrip
    text = text.byteslice(break_at..).sub(/\A[ \t]+/, '')
    prefix = continuation_prefix
  end
  lines
end

lines = source.lines(chomp: true).flat_map.with_index(1) do |line, line_number|
  next [line] if line.bytesize <= columns

  if (comment_at = comment_index(line))
    body = line.byteslice((comment_at + 1)..)
    spacing = body[/\A[ \t]*/]
    first_prefix = line.byteslice(0, comment_at + 1) + spacing
    # Keep continuations in the standard listing comment column instead of a far-right inline column.
    continuation_prefix = (' ' * [comment_at, COMMENT_COLUMN].min) + ';' + spacing
    wrap_at_words(body.byteslice(spacing.bytesize..), first_prefix, continuation_prefix, columns, line_number)
  else
    indentation = line[/\A[ \t]*/]
    wrap_at_words(line.byteslice(indentation.bytesize..), indentation, indentation, columns, line_number)
  end
end

symbol = /[A-Za-z_.$?@][A-Za-z0-9_.$?@]*/
namespace = /[A-Za-z_.$?@][^\s:]*/
qualified_address = /#{namespace}::(?:[0-9A-Fa-f]+:)?[0-9A-Fa-f]+/
address = /(?:#{namespace}::)?(?:[0-9A-Fa-f]+:)?[0-9A-Fa-f]+/
address_destinations = {}
symbol_destinations = {}
anchors_at = Hash.new { |hash, index| hash[index] = [] }
address_definition_at = {}
instruction_address_at = {}
destination_number = 0
lines.each_with_index do |line, index|
  leading_address = line.match(/\A[ \t]*(?<address>#{address})(?=\s)/)
  match = leading_address || line.match(/(?:\[offcut |; offcut at )(?<address>#{address})(?:\]|(?=\s|$))/)
  if match
    address_definition_at[index] = match.offset(:address)
    instruction_address_at[index] = match.offset(:address) if leading_address
    unless address_destinations.key?(match[:address])
      destination_number += 1
      address_destinations[match[:address]] = "xref-#{destination_number}"
      anchors_at[index] << address_destinations[match[:address]]
    end
  end

  match = line.match(/\A(?<symbol>#{symbol}):(?=\s*(?:;|$))/)
  next unless match

  abort "Duplicate label definition: #{match[:symbol]}" if symbol_destinations.key?(match[:symbol])
  destination_number += 1
  symbol_destinations[match[:symbol]] = "xref-#{destination_number}"
  anchors_at[index] << symbol_destinations[match[:symbol]]
end

xref_reference = /(?<![A-Za-z0-9_.$?@:])#{address}(?=\([A-Za-z*]{1,2}\))/
qualified_reference = /(?<![A-Za-z0-9_.$?@:])#{qualified_address}(?![A-Za-z0-9_.$?@:])/
rendered = lines.each_with_index.map do |line, index|
  candidates = []
  # Labels link only from instruction operands; exact address references may appear anywhere.
  [xref_reference, qualified_reference].each do |reference|
    line.to_enum(:scan, reference).each do
      match = Regexp.last_match
      id = address_destinations[match[0]]
      candidates << [*match.offset(0), id] if id && match.offset(0) != address_definition_at[index]
    end
  end

  if (address_range = instruction_address_at[index])
    code_end = line.index(';') || line.length
    tail = line[address_range[1]...code_end]
    if tail && (match = tail.match(/\A\s+\S+\s+\S+\s+(?<operands>.+?)\s*\z/))
      operand_start = address_range[1] + match.begin(:operands)
      operands = match[:operands]
      operands.to_enum(:scan, symbol).each do
        symbol_match = Regexp.last_match
        next if operands[symbol_match.end(0)] == ':'
        next if symbol_match.begin(0) >= 2 && operands[symbol_match.begin(0) - 2, 2] == '::'

        id = symbol_destinations[symbol_match[0]]
        candidates << [operand_start + symbol_match.begin(0), operand_start + symbol_match.end(0), id] if id
      end
    end
  end

  linked = String.new(encoding: line.encoding)
  cursor = 0
  candidates.uniq.sort_by { |from, to, _id| [from, from - to] }.each do |from, to, id|
    next if from < cursor

    target = line[from...to]
    linked << line[cursor...from]
    linked << "(*@\\hyperlink{#{id}}{\\listingfont\\detokenize{#{target}}}@*)"
    cursor = to
  end
  linked << line[cursor..]

  anchors = anchors_at[index].map { |id| "(*@\\hypertarget{#{id}}{}@*)" }.join
  line = anchors + linked
  line.strip.empty? ? " " : line
end
File.binwrite(output, rendered.join("\n") + "\n")
RUBY

  cat > "$v_temp_dir/listing.tex" <<EOF
\documentclass{article}
\usepackage[T1]{fontenc}
\usepackage{xcolor,listings}
\usepackage[paperwidth=1024bp,paperheight=1366bp,left=${v_margin}bp,right=${v_margin}bp,top=52bp,bottom=52bp]{geometry}
\usepackage[hidelinks]{hyperref}
\font\listingfont=ectt1000 at ${v_font_size}bp
\definecolor{codeblack}{RGB}{18,18,18}
\definecolor{codegreen}{RGB}{0,158,0}
\definecolor{codemagenta}{RGB}{255,0,158}
\definecolor{codebackground}{RGB}{229,229,229}
\definecolor{coderule}{RGB}{85,85,85}
\lstset{
  language={[x86masm]Assembler},
  basicstyle={\fontsize{${v_font_size}bp}{${v_line_spacing}bp}\selectfont\listingfont\color{codeblack}},
  keywordstyle=\color{codemagenta},
  commentstyle=\color{codegreen},
  stringstyle=\color{codeblack},
  backgroundcolor=\color{codebackground},
  frame=tb,
  framerule=.65bp,
  rulecolor=\color{coderule},
  framesep=14bp,
  columns=fullflexible,
  keepspaces=true,
  showstringspaces=false,
  escapeinside={(*@}{@*)},
  literate={×}{{$\times$}}1,
  tabsize=8
}
\begin{document}
\lstinputlisting{listing.asm}
\end{document}
EOF
}

function generate_pdf {
  (cd "$v_temp_dir" && pdflatex -interaction=nonstopmode -halt-on-error listing.tex)
  cp "$v_temp_dir/listing.pdf" "$v_output"
  echo "$v_output"
}

decode_cmdline_args "$@"
validate_parameters
prepare_files
generate_pdf
